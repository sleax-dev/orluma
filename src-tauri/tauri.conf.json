{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orluma",
  "version": "0.1.8",
  "identifier": "app.orluma.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Orluma",
        "width": 1180,
        "height": 760,
        "center": true,
        "transparent": true,
        "theme": "Dark",
        "decorations": false,
        "resizable": false,
        "maximizable": false,
        "minimizable": true,
        "closable": true,
        "visible": false,
        "shadow": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Utility",
    "shortDescription": "Backups for your servers, run from your desktop",
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": ["English", "Turkish", "Spanish", "German", "French", "PortugueseBR", "Russian", "SimpChinese", "Japanese", "Arabic"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyMTU0RTkxNEFDRjI1RDYKUldUV0pjOUtrVTRWTWc2aGM0NXVkWlFJM3RHQ0FiazM5VTA1anVoRStVdlR2ZlpDdFdaN1ovZzgK",
      "endpoints": ["https://github.com/sleax-dev/orluma/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
